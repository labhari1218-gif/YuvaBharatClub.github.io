---
import AnimatedLogo from "../common/AnimatedLogo.astro";
import { assetUrl, withBase } from "../../lib/site";

interface Props {
  settings: {
    siteDescription: string;
    heroTaglineEn: string;
    heroTaglineHi?: string;
    campusName: string;
  };
}

const { settings } = Astro.props;
---

<section class="hero">
  <div class="hero__ambient" aria-hidden="true">
    <span class="hero__halo hero__halo--saffron"></span>
    <span class="hero__halo hero__halo--green"></span>
    <span class="hero__halo hero__halo--navy"></span>
    <span class="hero__gridlines"></span>
  </div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">Student-led action at IISER Bhopal</p>
      <h1>Yuva Bharat Club</h1>
      <p class="hero__lead">{settings.siteDescription}</p>
      <p class="hero__tagline">{settings.heroTaglineEn}</p>
      {settings.heroTaglineHi && <p class="hero__tagline hero__tagline--hi">{settings.heroTaglineHi}</p>}
      <div class="hero__actions">
        <a class="button" href={withBase("/events")}>See events</a>
        <a class="button button--ghost" href={withBase("/join")}>Join the club</a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero-card">
        <div class="hero-card__sheen" aria-hidden="true"></div>
        <img
          class="hero-card__flag"
          src={assetUrl("/images/brand/flag-of-india.svg")}
          alt="Flag of India"
          width="900"
          height="600"
        />
        <div class="hero-card__badge">
          <AnimatedLogo size={88} label="Yuva Bharat Club logo" variant="rich" />
          <span>{settings.campusName}</span>
        </div>
      </div>
    </div>
  </div>
</section>
