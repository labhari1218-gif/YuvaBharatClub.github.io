---
import CtaBanner from "../ui/CtaBanner.astro";

interface Props {
  joinUrl?: string;
}

const { joinUrl } = Astro.props;
---

<CtaBanner
  title="Want to get involved?"
  copy="If you want to help plan, volunteer, document, design, or participate, Yuva Bharat Club offers more than one way to contribute."
  primaryLabel={joinUrl ? "Open join form" : "See how to join"}
  primaryHref={joinUrl ?? "/join"}
  secondaryLabel="See events"
  secondaryHref="/events"
/>
