---
import { gmailComposeUrl, withBase } from "../../lib/site";

interface Props {
  title: string;
  copy: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  copy,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref
} = Astro.props;

const primaryIsMail = primaryHref.startsWith("mailto:");
const secondaryIsMail = secondaryHref?.startsWith("mailto:");
---

<section class="cta-banner">
  <div class="cta-banner__content">
    <p class="section-heading__eyebrow">Get involved</p>
    <h2>{title}</h2>
    <p>{copy}</p>
  </div>

  <div class="cta-banner__actions">
    <a
      class="button"
      href={withBase(primaryHref)}
      data-email-link={primaryIsMail ? true : undefined}
      data-gmail-compose={primaryIsMail ? gmailComposeUrl(primaryHref.replace(/^mailto:/, "").split("?")[0]) : undefined}
    >{primaryLabel}</a>
    {secondaryLabel && secondaryHref && (
      <a
        class="button button--ghost"
        href={withBase(secondaryHref)}
        data-email-link={secondaryIsMail ? true : undefined}
        data-gmail-compose={secondaryIsMail ? gmailComposeUrl(secondaryHref.replace(/^mailto:/, "").split("?")[0]) : undefined}
      >{secondaryLabel}</a>
    )}
  </div>
</section>
