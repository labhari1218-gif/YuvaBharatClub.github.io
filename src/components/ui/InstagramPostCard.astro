---
import { formatDate } from "../../lib/date";

interface InstagramPost {
  id: string;
  shortcode: string;
  permalink: string;
  date: Date;
  caption: string;
  excerpt: string;
  coverImage: string;
  altText: string;
  mediaType: "image" | "video" | "carousel";
  likeCount: number | null;
  commentCount: number | null;
}

interface Props {
  post: InstagramPost;
}

const { post } = Astro.props;
const postLabel =
  post.mediaType === "carousel" ? "Carousel" : post.mediaType === "video" ? "Video" : "Image";
---

<article class="card">
  <img
    class="card__media instagram-post-card__media"
    src={post.coverImage}
    alt={post.altText}
    loading="lazy"
    width="640"
    height="640"
  />
  <div class="card__body">
    <div class="card__meta">
      <span>{postLabel}</span>
      <span>{formatDate(post.date)}</span>
    </div>
    <h3>Instagram post</h3>
    <p class="instagram-post-card__caption">{post.caption || post.excerpt}</p>
    <a class="text-link" href={post.permalink} target="_blank" rel="noreferrer">Open post</a>
  </div>
</article>
