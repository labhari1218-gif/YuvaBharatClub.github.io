<script is:inline>
  (() => {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const supportsHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const prefersLiteMotion = window.matchMedia("(max-width: 900px), (hover: none), (pointer: coarse)").matches;
    const body = document.body;
    const root = document.documentElement;

    if (prefersReducedMotion.matches || prefersLiteMotion) {
      body.classList.add("motion-lite");
      root.style.setProperty("--scroll-progress", "0");
    } else {
      body.classList.add("motion-ready");
    }

    const useAndroidMailFallback =
      /Android/i.test(navigator.userAgent) || prefersLiteMotion;

    if (useAndroidMailFallback) {
      document.querySelectorAll("a[data-email-link]").forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        const gmailCompose = link.dataset.gmailCompose;
        if (!gmailCompose) return;
        link.href = gmailCompose;
        link.target = "_blank";
        link.rel = "noreferrer noopener";
      });
    }

    if (prefersReducedMotion.matches || prefersLiteMotion) {
      return;
    }

    const revealTargets = [
      ...document.querySelectorAll(
        [
          ".hero__copy",
          ".hero__visual",
          ".quick-values article",
          ".section-heading",
          ".about-snapshot",
          ".about-story",
          ".about-story__side",
          ".overview-card",
          ".working-area-card",
          ".card",
          ".sidebar-card",
          ".cta-banner",
          ".gallery-preview",
          ".gallery-preview__grid img",
          ".detail-hero__grid",
          ".page-hero .container",
          ".site-footer__grid > *",
          ".site-footer__meta"
        ].join(",")
      )
    ];

    revealTargets.forEach((element, index) => {
      element.classList.add("reveal-on-scroll");
      element.style.setProperty("--reveal-delay", `${Math.min(index % 6, 5) * 70}ms`);
      element.style.setProperty("--float-delay", `${(index % 7) * 0.7}s`);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.14, rootMargin: "0px 0px -8% 0px" }
    );

    revealTargets.forEach((element) => {
      const rect = element.getBoundingClientRect();

      if (rect.top < window.innerHeight * 0.92 && rect.bottom > 0) {
        element.classList.add("is-visible");
        return;
      }

      observer.observe(element);
    });

    const hero = document.querySelector(".hero");

    if (hero && supportsHover) {
      const updateHeroGlow = (event) => {
        const rect = hero.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width) * 100;
        const y = ((event.clientY - rect.top) / rect.height) * 100;
        hero.style.setProperty("--hero-pointer-x", `${x}%`);
        hero.style.setProperty("--hero-pointer-y", `${y}%`);
      };

      hero.addEventListener("pointermove", updateHeroGlow);
      hero.addEventListener("pointerleave", () => {
        hero.style.removeProperty("--hero-pointer-x");
        hero.style.removeProperty("--hero-pointer-y");
      });
    }

    if (supportsHover) {
      const tiltTargets = document.querySelectorAll(
        [
          ".hero-card",
          ".quick-values article",
          ".card",
          ".about-snapshot",
          ".about-story",
          ".about-story__side",
          ".overview-card",
          ".working-area-card",
          ".cta-banner"
        ].join(",")
      );

      tiltTargets.forEach((element) => {
        element.classList.add("tilt-surface");

        element.addEventListener("pointermove", (event) => {
          const rect = element.getBoundingClientRect();
          const px = (event.clientX - rect.left) / rect.width;
          const py = (event.clientY - rect.top) / rect.height;
          const rotateY = (px - 0.5) * 18;
          const rotateX = (0.5 - py) * 16;

          element.style.setProperty("--tilt-rotate-x", `${rotateX}deg`);
          element.style.setProperty("--tilt-rotate-y", `${rotateY}deg`);
          element.style.setProperty("--tilt-glow-x", `${px * 100}%`);
          element.style.setProperty("--tilt-glow-y", `${py * 100}%`);
          element.style.setProperty("--tilt-scale", "1.02");
          element.classList.add("is-tilting");
        });

        element.addEventListener("pointerleave", () => {
          element.classList.remove("is-tilting");
          element.style.removeProperty("--tilt-rotate-x");
          element.style.removeProperty("--tilt-rotate-y");
          element.style.removeProperty("--tilt-glow-x");
          element.style.removeProperty("--tilt-glow-y");
          element.style.removeProperty("--tilt-scale");
        });
      });
    }

    let ticking = false;
    const updateScroll = () => {
      const maxScroll = Math.max(document.body.scrollHeight - window.innerHeight, 1);
      root.style.setProperty("--scroll-progress", `${window.scrollY / maxScroll}`);
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateScroll);
      },
      { passive: true }
    );

    updateScroll();
  })();
</script>
