---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventCard from "../../components/events/EventCard.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { getPublicEvents } from "../../lib/content";

const events = await getPublicEvents();
const upcoming = events.filter((event) => event.data.status === "upcoming");
const past = events.filter((event) => event.data.status !== "upcoming");
---

<BaseLayout
  title="Events | Yuva Bharat Club"
  description="Explore upcoming events and selected past programs from Yuva Bharat Club at IISER Bhopal."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-heading__eyebrow">Events</p>
      <h1>Events, discussions, and campus activity</h1>
      <p class="page-hero__lead">
        From dialogue-led sessions to student-led programs, this page brings together the work of
        Yuva Bharat Club.
      </p>
      <p class="hero__tagline hero__tagline--hi">कार्यक्रम, संवाद और सार्थक भागीदारी।</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Upcoming"
        title="What’s coming up"
        description="See upcoming programs where students can attend, volunteer, or take part."
      />
      {upcoming.length ? (
        <div class="card-grid">{upcoming.map((event) => <EventCard event={event} />)}</div>
      ) : (
        <EmptyState title="No upcoming events yet" copy="The next public event will appear here once details are ready." />
      )}
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <SectionHeading
        eyebrow="Highlights"
        title="Past events and highlights"
        description="These pages offer a clear record of the club’s recent activities, themes, and outcomes."
      />
      {past.length ? (
        <div class="card-grid">{past.map((event) => <EventCard event={event} />)}</div>
      ) : (
        <EmptyState title="No past event pages yet" copy="Past events will appear here as the archive grows." />
      )}
    </div>
  </section>
</BaseLayout>
