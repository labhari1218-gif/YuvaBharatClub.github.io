---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryPreview from "../components/home/GalleryPreview.astro";
import Hero from "../components/home/Hero.astro";
import HighlightsGrid from "../components/home/HighlightsGrid.astro";
import JoinBanner from "../components/home/JoinBanner.astro";
import QuickValueStrip from "../components/home/QuickValueStrip.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import InitiativeCard from "../components/ui/InitiativeCard.astro";
import {
  getPublicEvents,
  getPublicGalleryAlbums,
  getPublicInitiatives,
  getSiteSettings,
  pickFeatured
} from "../lib/content";

const settings = await getSiteSettings();
const events = await getPublicEvents();
const initiatives = (await getPublicInitiatives()).slice(0, 3);
const galleryAlbums = await getPublicGalleryAlbums();
const featuredEvents = events.slice(0, 3);
const featuredAlbums = pickFeatured(galleryAlbums, settings.homepage.featuredGallerySlugs);
---

<BaseLayout title="Yuva Bharat Club" description={settings.siteDescription}>
  <Hero settings={settings} />
  <QuickValueStrip />

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="What the club is"
        title="A student-led space for dialogue, events, and campus participation"
        description="Yuva Bharat Club brings students together to discuss ideas, help run events, and take part in campus life with purpose."
      />
      <div class="about-snapshot surface">
        <p>
          It is a place for students who want to do more than attend. The club creates room to speak, contribute,
          volunteer, and build work that others can carry forward.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Events"
        title="What the club has been doing"
        description="Recent events offer the quickest picture of the club’s energy, themes, and work on campus."
        actionLabel="See all events"
        actionHref="/events"
      />
      <HighlightsGrid events={featuredEvents} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Initiatives"
        title="Ongoing work beyond one-day events"
        description="These initiatives show how the club builds continuity across leadership, dialogue, and documentation."
      />
      <div class="card-grid">
        {initiatives.map((initiative) => <InitiativeCard initiative={initiative} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Gallery"
        title="Moments from events and preparation"
        description="A quick visual look at the people, effort, and atmosphere behind the club’s activities."
      />
      <GalleryPreview albums={featuredAlbums} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <JoinBanner joinUrl={settings.joinUrl} />
    </div>
  </section>
</BaseLayout>
