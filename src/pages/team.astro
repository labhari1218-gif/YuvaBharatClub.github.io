---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import TeamCard from "../components/ui/TeamCard.astro";
import { getPublicTeam } from "../lib/content";

const team = await getPublicTeam();
---

<BaseLayout
  title="Team | Yuva Bharat Club"
  description="Meet the team roles that organize, document, design, coordinate, and support Yuva Bharat Club."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-heading__eyebrow">Team</p>
      <h1>Team roles that keep the club moving</h1>
      <p class="page-hero__lead">
        This page highlights the roles that help the club plan events, support participation,
        and keep its work organized.
      </p>
      <p class="hero__tagline hero__tagline--hi">भूमिकाएँ स्पष्ट हों, तभी काम बेहतर चलता है।</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Public-facing team roles"
        title="Different roles, shared responsibility"
        description="Each role supports a different part of the club’s work, from coordination and outreach to documentation and design."
      />
      <div class="card-grid team-grid">
        {team.map((member) => <TeamCard member={member} />)}
      </div>
    </div>
  </section>
</BaseLayout>
