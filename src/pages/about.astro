---
import PillarGrid from "../components/home/PillarGrid.astro";
import CtaBanner from "../components/ui/CtaBanner.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageEntry, getSiteSettings } from "../lib/content";

const page = await getPageEntry("about-page");
const settings = await getSiteSettings();
const overviewCards = [
  {
    title: "What it is",
    copy: "A student-led club for dialogue, events, leadership, and meaningful participation at IISER Bhopal."
  },
  {
    title: "What happens here",
    copy: "Students help plan events, support discussions, contribute creative work, and take part in collaborative campus activity."
  },
  {
    title: "Why it matters",
    copy: "The club gives students real ways to participate, take responsibility, and build something useful together."
  }
];

const workingAreas = [
  {
    title: "Events & Coordination",
    copy: "Planning, logistics, and on-ground execution that turn ideas into real campus programs."
  },
  {
    title: "Dialogue & Moderation",
    copy: "Conversation formats, hosting, and speaking spaces that help students engage with confidence."
  },
  {
    title: "Documentation",
    copy: "Notes, visuals, and archives that preserve useful context for future teams."
  },
  {
    title: "Media & Design",
    copy: "Visual identity, posters, and communication that support events and public-facing initiatives."
  },
  {
    title: "Outreach & Participation",
    copy: "Volunteer coordination and outreach that help more students find a meaningful place in the work."
  }
];
---

<BaseLayout
  title={page.data.seoTitle ?? page.data.title}
  description={page.data.seoDescription ?? page.data.description}
>
  <section class="page-hero">
    <div class="container">
      <p class="section-heading__eyebrow">About</p>
      <h1>{page.data.title}</h1>
      <p class="page-hero__lead">{page.data.intro}</p>
      {page.data.optionalHindiExcerpt && <p class="hero__tagline hero__tagline--hi">{page.data.optionalHindiExcerpt}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container about-story-grid">
      <article class="about-story surface">
        <SectionHeading
          eyebrow="Who we are"
          title="A club built on participation"
          description="Yuva Bharat Club brings students together to discuss, organize, and take part in campus life with purpose."
        />
        <p>
          Students can contribute by organizing events, joining discussions, supporting documentation,
          and helping turn ideas into visible campus activity.
        </p>
        <p>
          At its core, the club is about participation with purpose.
          <span class="inline-hi">सार्थक सहभागिता, स्पष्ट संवाद, और छात्र-नेतृत्व पहल।</span>
        </p>
      </article>

      <aside class="sidebar-card about-story__side">
        <p class="section-heading__eyebrow">At a glance</p>
        <ul class="about-glance-list">
          <li>Student-led, campus-rooted, and collaborative</li>
          <li>Built around dialogue, events, and follow-through</li>
          <li>Open to students who want to contribute, not just attend</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <SectionHeading
        eyebrow="In brief"
        title="What Yuva Bharat Club is here to do"
        description="A clear introduction to the club’s role on campus."
      />
      <div class="overview-grid">
        {overviewCards.map((card) => (
          <article class="overview-card">
            <h3>{card.title}</h3>
            <p>{card.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Working areas"
        title="How the club works"
        description="These working areas support the full arc of a campus activity, from planning to follow-up."
      />
      <div class="working-areas-grid">
        {workingAreas.map((area) => (
          <article class="working-area-card">
            <h3>{area.title}</h3>
            <p>{area.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <SectionHeading
        eyebrow="Focus pillars"
        title="The values behind the work"
        description="These pillars shape how the club plans, participates, and follows through."
      />
      <PillarGrid pillars={settings.focusPillars} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBanner
        title="See the club through its work"
        copy="Browse events, initiatives, and gallery highlights to understand what Yuva Bharat Club looks like in practice."
        primaryLabel="See events"
        primaryHref="/events"
        secondaryLabel="How to join"
        secondaryHref="/join"
      />
    </div>
  </section>
</BaseLayout>
