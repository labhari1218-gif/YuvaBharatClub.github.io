---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportCard from "../../components/ui/ReportCard.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { getPublicReports } from "../../lib/content";

const reports = await getPublicReports();
---

<BaseLayout
  title="Reports | Yuva Bharat Club"
  description="Read approved event summaries, public reports, and selected documentation that showcase the club’s work and learning."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-heading__eyebrow">Reports</p>
      <h1>Reports, notes, and public summaries</h1>
      <p class="page-hero__lead">These pages document what the club organized, discussed, and learned across its public activities.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Recent reports"
        title="A written record of the club’s recent work"
        description="Some entries include a PDF, while others work as short written recaps."
      />
      <div class="card-grid">
        {reports.map((report) => <ReportCard report={report} />)}
      </div>
    </div>
  </section>
</BaseLayout>
