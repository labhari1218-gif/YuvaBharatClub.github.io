---
import { formatDate } from "../../lib/date";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GalleryAlbumCard from "../../components/ui/GalleryAlbumCard.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import InstagramPostCard from "../../components/ui/InstagramPostCard.astro";
import { getInstagramFeed, getPublicGalleryAlbums } from "../../lib/content";

const albums = await getPublicGalleryAlbums();
const instagramFeed = await getInstagramFeed();
const instagramPosts = instagramFeed?.data.posts ?? [];
---

<BaseLayout
  title="Gallery | Yuva Bharat Club"
  description="Browse gallery albums from Yuva Bharat Club events, preparation, and public campus activity."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-heading__eyebrow">Gallery</p>
      <h1>Gallery</h1>
      <p class="page-hero__lead">A visual record of events, preparation, and participation across the club’s activities.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Albums"
        title="Albums from recent activity"
        description="Each album brings together images from a specific event or phase of work."
      />
      <div class="card-grid">
        {albums.map((album) => <GalleryAlbumCard album={album} />)}
      </div>
    </div>
  </section>

  {instagramFeed && instagramPosts.length > 0 && (
    <section class="section section--cream">
      <div class="container">
        <SectionHeading
          eyebrow="Instagram"
          title="Instagram archive"
          description={`All public posts from @${instagramFeed.data.username}, collected here with their images and captions. Last updated ${formatDate(instagramFeed.data.fetchedAt)}.`}
          actionLabel="Open Instagram"
          actionHref={instagramFeed.data.profileUrl}
        />
        <div class="instagram-grid">
          {instagramPosts.map((post) => <InstagramPostCard post={post} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
