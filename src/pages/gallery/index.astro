---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GalleryAlbumCard from "../../components/ui/GalleryAlbumCard.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { getPublicGalleryAlbums } from "../../lib/content";

const albums = await getPublicGalleryAlbums();
---

<BaseLayout
  title="Gallery | Yuva Bharat Club"
  description="Browse gallery albums from Yuva Bharat Club events, preparation, and public campus activity."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-heading__eyebrow">Gallery</p>
      <h1>Gallery</h1>
      <p class="page-hero__lead">A visual record of events, preparation, and participation across the club’s activities.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Albums"
        title="Albums from recent activity"
        description="Each album brings together images from a specific event or phase of work."
      />
      <div class="card-grid">
        {albums.map((album) => <GalleryAlbumCard album={album} />)}
      </div>
    </div>
  </section>
</BaseLayout>
