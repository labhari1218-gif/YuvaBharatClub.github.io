---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/ui/CtaBanner.astro";
import EmailLink from "../components/ui/EmailLink.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { getPageEntry, getSiteSettings } from "../lib/content";
import { isPublicEmail, isPublicLink, mailtoUrl, withBase } from "../lib/site";

const page = await getPageEntry("join-page");
const settings = await getSiteSettings();
const { Content } = await render(page);
const publicEmail = isPublicEmail(settings.email) ? settings.email : undefined;
const publicJoinUrl = isPublicLink(settings.joinUrl) ? settings.joinUrl : undefined;
const publicRegistrationLinks = settings.registrationLinks?.filter((link) => isPublicLink(link.href)) ?? [];
---

<BaseLayout
  title={page.data.seoTitle ?? page.data.title}
  description={page.data.seoDescription ?? page.data.description}
>
  <section class="page-hero">
    <div class="container">
      <p class="section-heading__eyebrow">Join</p>
      <h1>{page.data.title}</h1>
      <p class="page-hero__lead">{page.data.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container page-grid">
      <article class="prose surface">
        <Content />
      </article>

      <aside class="sidebar-card">
        <SectionHeading title="Ways to get involved" description="Use official forms when available, or start with events and initiatives." />
        <ul class="feature-list">
          {publicRegistrationLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
            </li>
          ))}
          {publicEmail && <li><EmailLink email={publicEmail} /></li>}
          {!publicRegistrationLinks.length && !publicEmail && <li>The simplest way to get involved right now is through public events and ongoing initiatives.</li>}
          <li><a href={withBase("/events")}>See events</a></li>
          <li><a href={withBase("/initiatives")}>Explore initiatives</a></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBanner
        title="Start where your interest fits"
        copy="Whether you like events, dialogue, design, or documentation, the easiest way in is to begin with the club’s events and initiatives."
        primaryLabel={publicJoinUrl ? "Open join form" : "See events"}
        primaryHref={publicJoinUrl ?? "/events"}
        secondaryLabel={publicEmail ? "Email the club" : "Explore initiatives"}
        secondaryHref={publicEmail ? mailtoUrl(publicEmail) : "/initiatives"}
      />
    </div>
  </section>
</BaseLayout>
