---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/ui/CtaBanner.astro";

---

<BaseLayout title="Page not found | Yuva Bharat Club" description="The page you requested does not exist." noindex={true}>
  <section class="page-hero">
    <div class="container">
      <p class="section-heading__eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="page-hero__lead">The page you’re looking for doesn’t exist or may have moved.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBanner
        title="Find your way back"
        copy="Start from the homepage or jump straight to the club’s events."
        primaryLabel="Go to homepage"
        primaryHref="/"
        secondaryLabel="See events"
        secondaryHref="/events"
      />
    </div>
  </section>
</BaseLayout>
