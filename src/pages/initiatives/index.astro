---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublicInitiatives } from "../../lib/content";
import InitiativeCard from "../../components/ui/InitiativeCard.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";

const initiatives = await getPublicInitiatives();
---

<BaseLayout
  title="Initiatives | Yuva Bharat Club"
  description="Discover the club’s long-term initiatives and recurring formats across dialogue, leadership, and documentation."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-heading__eyebrow">Initiatives</p>
      <h1>Initiatives that give the club continuity</h1>
      <p class="page-hero__lead">Beyond individual events, these initiatives show how the club sustains dialogue, leadership, and documentation over time.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Ongoing work"
        title="Themes the club keeps building"
        description="Each initiative reflects a working area the club continues to strengthen over time."
      />
      <div class="card-grid">
        {initiatives.map((initiative) => <InitiativeCard initiative={initiative} />)}
      </div>
    </div>
  </section>
</BaseLayout>
