---
import Footer from "../components/common/Footer.astro";
import Header from "../components/common/Header.astro";
import MotionDesign from "../components/common/MotionDesign.astro";
import SeoHead from "../components/common/SeoHead.astro";
import "../styles/global.css";
import { getSiteSettings } from "../lib/content";
import { isPublicEmail, isPublicLink } from "../lib/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
const settings = await getSiteSettings();
const socials = [
  isPublicLink(settings.instagramUrl) ? { label: "Instagram", href: settings.instagramUrl } : undefined,
  isPublicLink(settings.linkedinUrl) ? { label: "LinkedIn", href: settings.linkedinUrl } : undefined,
  isPublicLink(settings.youtubeUrl) ? { label: "YouTube", href: settings.youtubeUrl } : undefined,
  isPublicLink(settings.githubUrl) ? { label: "GitHub", href: settings.githubUrl } : undefined
].filter(Boolean) as { label: string; href: string }[];
const publicEmail = isPublicEmail(settings.email) ? settings.email : undefined;
---

<!doctype html>
<html lang={settings.defaultLocale}>
  <head>
    <SeoHead title={title} description={description} image={image ?? settings.seoImage} noindex={noindex} />
  </head>
  <body>
    <div class="site-aura" aria-hidden="true">
      <span class="site-aura__orb site-aura__orb--saffron"></span>
      <span class="site-aura__orb site-aura__orb--green"></span>
      <span class="site-aura__orb site-aura__orb--navy"></span>
      <span class="site-aura__mesh"></span>
    </div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header currentPath={Astro.url.pathname} siteTitle={settings.siteTitle} shortTitle={settings.shortTitle} />
    <main id="main-content">
      <slot />
    </main>
    <Footer
      footerText={settings.footerText}
      siteTitle={settings.siteTitle}
      email={publicEmail}
      socials={socials}
    />
    <MotionDesign />
  </body>
</html>
